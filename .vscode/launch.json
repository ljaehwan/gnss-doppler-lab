{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GPS 정상 IQ 생성 (F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_iq.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "GPS IQ 그래프 생성 (F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/visualize_iq.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "전체 테스트 실행",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
