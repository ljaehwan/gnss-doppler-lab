{
  "schema": "gnss-doppler-lab.gcspo-stage0.a5-controller-witness-schemas.v1",
  "canonical_json": {
    "encoding": "UTF-8",
    "json": "sort_keys=true,separators=(',',':'),allow_nan=false",
    "terminator": "single LF",
    "verification": "on-disk bytes must equal canonical reserialization exactly before signature verification"
  },
  "signature": {
    "algorithm": "Ed25519 via OpenSSH ssh-keygen -Y",
    "identity": "gcspo-controller-witness",
    "namespace": "gnss-gcspo-controller-witness-v1",
    "public_key_path": "config/gnss_gcspo_witness_ed25519.pub",
    "public_key_fingerprint": "SHA256:L+STBb5P7+DDfilvAZUxV2eHGYZGfMQf4aDbXSsNi0c",
    "private_key_location": "external Hermes controller only; never VM/repository/artifacts/Codex"
  },
  "prepared": {
    "schema": "gnss-doppler-lab.gcspo-stage0.a5-controller-prepared.v2",
    "signature_file_suffix": ".sig",
    "required_exact_keys": [
      "schema", "status", "run_id", "nonce", "source_commit", "challenge_path",
      "challenge", "source_identities", "argv", "environment", "backend",
      "scratch_root", "output_root", "evidence_root", "prelaunch_assertions",
      "scientific_output_names", "controller", "prepared_signed_utc",
      "bounded_trust_assumption"
    ],
    "prelaunch_assertions": {
      "scratch_root_absent": true,
      "output_root_absent": true,
      "evidence_root_absent": true
    }
  },
  "execution_receipt": {
    "schema": "gnss-doppler-lab.gcspo-stage0.a5-execution-receipt.v1",
    "required_exact_keys": [
      "schema", "run_id", "nonce", "process_identity", "child_started_utc",
      "child_finished_utc", "backend_truth", "source_commit", "challenge", "argv",
      "scientific_outputs", "transcript_state"
    ],
    "scientific_comparison_exclusion": true
  },
  "completion_observation": {
    "schema": "gnss-doppler-lab.gcspo-stage0.a5-controller-completion-observation.v1",
    "signed": false,
    "purpose": "untrusted VM observation for the external controller to independently check after exact command exit"
  },
  "completed": {
    "schema": "gnss-doppler-lab.gcspo-stage0.a5-controller-completed.v2",
    "signature_file_suffix": ".sig",
    "required_exact_keys": [
      "schema", "status", "run_id", "nonce", "source_commit", "challenge_path",
      "challenge", "prepared_envelope", "prepared_signature", "argv", "environment",
      "backend", "observed_exit_code", "process_identity",
      "observed_process_start_utc", "observed_process_end_utc", "observed_elapsed_ns",
      "stdout", "stderr", "execution_receipt", "backend_truth", "scientific_outputs",
      "post_run_source", "controller", "completed_signed_utc",
      "bounded_trust_assumption"
    ],
    "controller_transformation": {
      "copy_from_completion_observation": [
        "run_id", "nonce", "source_commit", "challenge_path", "challenge",
        "prepared_envelope", "prepared_signature", "argv", "environment", "backend",
        "observed_exit_code", "process_identity", "observed_process_start_utc",
        "observed_process_end_utc", "observed_elapsed_ns", "stdout", "stderr",
        "execution_receipt", "backend_truth", "scientific_outputs", "post_run_source"
      ],
      "set": {
        "schema": "gnss-doppler-lab.gcspo-stage0.a5-controller-completed.v2",
        "status": "COMPLETED",
        "controller": {
          "public_key_fingerprint": "SHA256:L+STBb5P7+DDfilvAZUxV2eHGYZGfMQf4aDbXSsNi0c",
          "identity": "gcspo-controller-witness",
          "namespace": "gnss-gcspo-controller-witness-v1"
        },
        "bounded_trust_assumption": "Independence is attested only under the bounded assumption that the external Hermes controller private key remains outside the VM and that the controller directly launches and observes each exact command; this is not hardware attestation."
      },
      "controller_supplies_after_observed_exit": "completed_signed_utc"
    }
  },
  "required_ordering": "prepared_signed_utc <= observed_process_start_utc < observed_process_end_utc <= completed_signed_utc",
  "distinct_across_three_runs": [
    "nonce", "PREPARED envelope hash", "PREPARED signature hash", "COMPLETED signature hash",
    "process identity", "process interval", "execution receipt hash", "scratch root", "evidence root"
  ],
  "trust_statement": "Independence is attested only under the bounded assumption that the external Hermes controller private key remains outside the VM and that the controller directly launches and observes each exact command; this is not hardware attestation."
}
