+dll_pll_veml_tracking::TraceActionSnapshot dll_pll_veml_tracking::trace_action_snapshot(uint64_t interval_length_samples) const
+{
+    TraceActionSnapshot action{};
+    action.code_nco_rate_chips_s = d_code_freq_chips;
+    action.carrier_doppler_hz = d_carrier_doppler_hz;
+    action.residual_code_phase_chips = d_rem_code_phase_chips;
+    action.residual_carrier_phase_rad = static_cast<double>(d_rem_carr_phase_rad);
+    action.code_phase_step_chips_per_sample = d_code_phase_step_chips;
+    action.carrier_phase_step_rad_per_sample = d_carrier_phase_step_rad;
+    action.code_phase_rate_step_chips_per_sample2 = d_code_phase_rate_step_chips;
+    action.carrier_phase_rate_step_rad_per_sample2 = d_carrier_phase_rate_step_rad;
+    action.dll_filter_output_chips_s = d_code_error_filt_chips;
+    action.pll_fll_filter_output_hz = d_carr_error_filt_hz;
+    action.carrier_phase_accumulator_rad = d_acc_carrier_phase_rad;
+    action.residual_code_phase_samples = d_rem_code_phase_samples;
+    action.interval_length_samples = interval_length_samples;
+    return action;
