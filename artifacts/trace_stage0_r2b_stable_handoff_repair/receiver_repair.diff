+void dll_pll_veml_tracking::log_trace_native_1ms(uint64_t raw_interval_start_sample,
+    uint64_t raw_interval_end_sample,
+    uint8_t receiver_state,
+    bool data_symbol_boundary,
+    const TraceActionSnapshot &action_used_for_current_interval)
+{
+    if (!d_trace_dump or !d_trace_dump_file.is_open() or d_acquisition_gnss_synchro == nullptr)
+        {
+            return;
+        }
+
+    // Receiver execution order and causal contract:
+    //   1. action_used_for_current_interval was snapped before correlation;
+    //   2. d_correlator_outs now contains the current raw 1 ms complex taps;
+    //   3. run_dll_pll() and update_tracking_vars() computed the action below;
+    //   4. that computed action remains in the receiver and is snapped as the
+    //      used action before the next correlation.  The source sequence field
+    //      proves row t next-action -> row t+1 used-action without inference.
+    const TraceActionSnapshot action_computed_for_next_interval =
+        trace_action_snapshot(static_cast<uint64_t>(d_current_prn_length_samples));
+
+    const uint64_t absolute_raw_interval_start_sample =
+        raw_interval_start_sample + d_trk_parameters.trace_raw_sample_offset;
+    const uint64_t absolute_raw_interval_end_sample =
+        raw_interval_end_sample + d_trk_parameters.trace_raw_sample_offset;
+    const double receiver_timestamp_s =
+        static_cast<double>(absolute_raw_interval_start_sample) / d_trk_parameters.fs_in;
+    const double integration_duration_s =
+        static_cast<double>(raw_interval_end_sample - raw_interval_start_sample) / d_trk_parameters.fs_in;
+    const uint32_t prn = d_acquisition_gnss_synchro->PRN;
+    const uint8_t valid_tracking = 1U;
+    const uint8_t valid_lock =
+        (d_carrier_lock_test >= d_carrier_lock_threshold and d_CN0_SNV_dB_Hz >= d_trk_parameters.cn0_min) ? 1U : 0U;
+    const uint8_t data_boundary = data_symbol_boundary ? 1U : 0U;
+    const uint8_t loop_update_boundary = 1U;
+    const uint8_t navigation_bit_wipeoff_applied = 0U;
+    const uint8_t pull_in_transitory = d_pull_in_transitory ? 1U : 0U;
+    const uint8_t reserved = 0U;
+
+    try
+        {
+            trace_write_value(d_trace_dump_file, d_trace_loop_sequence);
+            trace_write_value(d_trace_dump_file, d_trace_tracking_session_id);
+            trace_write_value(d_trace_dump_file, d_trace_action_source_sequence);
+            trace_write_value(d_trace_dump_file, absolute_raw_interval_start_sample);
+            trace_write_value(d_trace_dump_file, absolute_raw_interval_end_sample);
+            trace_write_value(d_trace_dump_file, receiver_timestamp_s);
+            trace_write_value(d_trace_dump_file, integration_duration_s);
+            trace_write_value(d_trace_dump_file, d_channel);
+            trace_write_value(d_trace_dump_file, prn);
+            trace_write_value(d_trace_dump_file, valid_tracking);
+            trace_write_value(d_trace_dump_file, valid_lock);
+            trace_write_value(d_trace_dump_file, data_boundary);
+            trace_write_value(d_trace_dump_file, loop_update_boundary);
+            trace_write_value(d_trace_dump_file, navigation_bit_wipeoff_applied);
+            trace_write_value(d_trace_dump_file, pull_in_transitory);
+            trace_write_value(d_trace_dump_file, receiver_state);
+            trace_write_value(d_trace_dump_file, reserved);
+
+            for (int32_t tap = 0; tap < 9; ++tap)
+                {
+                    const float tap_i = d_correlator_outs[tap].real();
+                    const float tap_q = d_correlator_outs[tap].imag();
+                    trace_write_value(d_trace_dump_file, tap_i);
+                    trace_write_value(d_trace_dump_file, tap_q);
+                }
+
+            trace_write_value(d_trace_dump_file, d_code_error_chips);
+            trace_write_value(d_trace_dump_file, d_carr_phase_error_hz);
+            trace_write_value(d_trace_dump_file, d_carr_freq_error_hz);
+            trace_write_value(d_trace_dump_file, d_code_error_filt_chips);
+            trace_write_value(d_trace_dump_file, d_carr_error_filt_hz);
+            trace_write_value(d_trace_dump_file, d_CN0_SNV_dB_Hz);
+            trace_write_value(d_trace_dump_file, d_carrier_lock_test);
+            trace_write_value(d_trace_dump_file, d_current_correlation_time_s);
+
+            const auto write_action = [this](const TraceActionSnapshot &action) {
+                trace_write_value(d_trace_dump_file, action.code_nco_rate_chips_s);
+                trace_write_value(d_trace_dump_file, action.carrier_doppler_hz);
+                trace_write_value(d_trace_dump_file, action.residual_code_phase_chips);
+                trace_write_value(d_trace_dump_file, action.residual_carrier_phase_rad);
+                trace_write_value(d_trace_dump_file, action.code_phase_step_chips_per_sample);
+                trace_write_value(d_trace_dump_file, action.carrier_phase_step_rad_per_sample);
+                trace_write_value(d_trace_dump_file, action.code_phase_rate_step_chips_per_sample2);
+                trace_write_value(d_trace_dump_file, action.carrier_phase_rate_step_rad_per_sample2);
+                trace_write_value(d_trace_dump_file, action.dll_filter_output_chips_s);
+                trace_write_value(d_trace_dump_file, action.pll_fll_filter_output_hz);
+                trace_write_value(d_trace_dump_file, action.carrier_phase_accumulator_rad);
+                trace_write_value(d_trace_dump_file, action.residual_code_phase_samples);
+                trace_write_value(d_trace_dump_file, action.interval_length_samples);
+            };
+            write_action(action_used_for_current_interval);
+            write_action(action_computed_for_next_interval);
+
+            d_trace_action_source_sequence = d_trace_loop_sequence;
+            ++d_trace_loop_sequence;
+            if ((d_trace_loop_sequence % 1000U) == 0U)
+                {
+                    d_trace_dump_file.flush();
+                }
+        }
+    catch (const std::ofstream::failure &e)
+        {
+            LOG(ERROR) << "TRACE native 1 ms dump write failed on channel " << d_channel << ": " << e.what();
+            d_trace_dump = false;
+        }
+}
