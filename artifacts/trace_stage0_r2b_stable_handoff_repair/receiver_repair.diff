+void dll_pll_veml_tracking::load_trace_handoff()
+{
+    if (d_trk_parameters.trace_handoff_filename.empty())
+        {
+            return;
+        }
+    std::ifstream stream(d_trk_parameters.trace_handoff_filename);
+    if (!stream.is_open())
+        {
+            LOG(ERROR) << "TRACE frozen handoff cannot open " << d_trk_parameters.trace_handoff_filename;
+            d_trace_dump = false;
+            return;
+        }
+    std::string line;
+    while (std::getline(stream, line))
+        {
+            if (line.empty() or line.rfind("channel,", 0) == 0)
+                {
+                    continue;
+                }
+            std::replace(line.begin(), line.end(), ',', ' ');
+            std::istringstream parser(line);
+            uint32_t channel = 0U;
+            uint32_t source_channel = 0U;
+            uint32_t prn = 0U;
+            uint64_t first_start = 0U;
+            uint64_t source_start = 0U;
+            TraceActionSnapshot action{};
+            if (parser >> channel >> source_channel >> prn >> first_start >> source_start
+                >> action.code_nco_rate_chips_s >> action.carrier_doppler_hz
+                >> action.residual_code_phase_chips >> action.residual_carrier_phase_rad
+                >> action.code_phase_step_chips_per_sample >> action.carrier_phase_step_rad_per_sample
+                >> action.code_phase_rate_step_chips_per_sample2 >> action.carrier_phase_rate_step_rad_per_sample2
+                >> action.dll_filter_output_chips_s >> action.pll_fll_filter_output_hz
+                >> action.carrier_phase_accumulator_rad >> action.residual_code_phase_samples
+                >> action.interval_length_samples and channel == d_channel)
+                {
+                    const bool finite = std::isfinite(action.code_nco_rate_chips_s) and std::isfinite(action.carrier_doppler_hz)
+                        and std::isfinite(action.residual_code_phase_chips) and std::isfinite(action.residual_carrier_phase_rad)
+                        and std::isfinite(action.code_phase_step_chips_per_sample) and std::isfinite(action.carrier_phase_step_rad_per_sample)
+                        and std::isfinite(action.code_phase_rate_step_chips_per_sample2) and std::isfinite(action.carrier_phase_rate_step_rad_per_sample2)
+                        and std::isfinite(action.dll_filter_output_chips_s) and std::isfinite(action.pll_fll_filter_output_hz)
+                        and std::isfinite(action.carrier_phase_accumulator_rad) and std::isfinite(action.residual_code_phase_samples);
+                    if (!finite or source_start == 0U or action.interval_length_samples == 0U
+                        or action.interval_length_samples > static_cast<uint64_t>(std::numeric_limits<int32_t>::max()))
+                        {
+                            LOG(ERROR) << "TRACE target-aligned handoff has invalid state on channel " << channel;
+                            d_trace_dump = false;
+                            return;
+                        }
+                    d_trace_handoff_prn = prn;
+                    d_trace_handoff_first_raw_start_sample = first_start;
+                    d_trace_handoff_action = action;
+                    d_trace_handoff_enabled = true;
+                    LOG(INFO) << "TRACE frozen handoff loaded for channel " << channel
+                              << " PRN " << prn << " first raw sample " << first_start
+                              << " source channel " << source_channel << " source raw sample " << source_start
+                              << " Doppler " << action.carrier_doppler_hz;
+                    return;
+                }
+        }
+    LOG(ERROR) << "TRACE frozen handoff missing channel " << d_channel;
+    d_trace_dump = false;
+}
