+void dll_pll_veml_tracking::write_trace_header()
+{
+    const std::array<char, 8> magic{{'T', 'R', 'C', '1', 'M', 'S', '0', '2'}};
+    d_trace_dump_file.write(magic.data(), magic.size());
+    trace_write_value(d_trace_dump_file, TRACE_SCHEMA_VERSION);
+    trace_write_value(d_trace_dump_file, TRACE_HEADER_SIZE_BYTES);
+    trace_write_value(d_trace_dump_file, TRACE_RECORD_SIZE_BYTES);
+    trace_write_value(d_trace_dump_file, TRACE_ENDIAN_MARKER);
+    trace_write_value(d_trace_dump_file, d_trk_parameters.fs_in);
+    trace_write_value(d_trace_dump_file, d_trk_parameters.tap_spacing_chips);
+    const float coherent_integration_s = static_cast<float>(d_code_period);
+    trace_write_value(d_trace_dump_file, coherent_integration_s);
+
+    std::array<char, 64> scenario_id{};
+    std::copy_n(d_trk_parameters.trace_scenario_id.data(),
+        std::min(d_trk_parameters.trace_scenario_id.size(), scenario_id.size() - 1U),
+        scenario_id.data());
+    d_trace_dump_file.write(scenario_id.data(), scenario_id.size());
+
+    std::array<char, 48> source_commit{};
+    constexpr char source_commit_text[] = "1ddd4562723040fd66cb334b578a5b69455625f4";
+    std::copy_n(source_commit_text, sizeof(source_commit_text) - 1U, source_commit.data());
+    d_trace_dump_file.write(source_commit.data(), source_commit.size());
+
+    for (int32_t tap = 0; tap < 9; ++tap)
+        {
+            const float offset_chips = static_cast<float>(tap - 4) * d_trk_parameters.tap_spacing_chips;
+            trace_write_value(d_trace_dump_file, offset_chips);
+        }
+    const uint32_t reserved = 0U;
+    trace_write_value(d_trace_dump_file, reserved);
+}
