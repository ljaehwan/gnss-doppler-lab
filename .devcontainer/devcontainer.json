{
  "name": "GNSS Doppler Lab (Linux)",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "lab",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "python -m pip install -e '.[dev]' && ./tools/build-gps-sdr-sim.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
