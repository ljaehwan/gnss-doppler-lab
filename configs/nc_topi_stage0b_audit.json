    "tangent_result": "if no shortcut trigger is true, all t1 through t7 are true, and the Profile_D conditional gate is true or not applicable, status = TANGENT_SUPPORTED",
    "fallback_result": "INCONCLUSIVE",
    "machine_grammar": {
      "numeric_domains": {
        "pauc": "finite [0,1]",
        "delta_pauc": "finite [-1,1]",
        "paired_ci_endpoint": "finite [-1,1] with lower <= upper",
        "q99_fpr": "finite [0,1]",
        "scale_gain_fraction": "finite real, defined only after its scenario denominator is >0",
        "alarm_overlap": "finite [0,1], defined only when original-NC alarm count >0"
      },
      "derived_values": {
        "delta_pauc.<scenario>.<A>_minus_<B>": "pauc.<scenario>.<A> - pauc.<scenario>.<B>",
        "scale_gain_fraction.<scenario>": "delta_pauc.<scenario>.IQ_LOW_ONLY_minus_B0 / delta_pauc.<scenario>.NC_TOPI_original_minus_B0",
        "alarm_overlap.NC_TOPI_original_with_IQ_LOW_ONLY.<scenario>": "intersection_count(q99_alarm.NC_TOPI_original, q99_alarm.IQ_LOW_ONLY) / count(q99_alarm.NC_TOPI_original)"
      },
      "undefined_derived_value": "validation error for support; shortcut d evaluates false unless all of its denominator prerequisites and values are defined",
