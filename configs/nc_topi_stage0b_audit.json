                      "rhs_ref": "pauc.DS7.NC_TOPI_clamped"
                    },
                    {
                      "lhs_ref": "pauc.DS8.IQ_LOW_ONLY",
                      "op": ">=",
                      "rhs_ref": "pauc.DS8.NC_TOPI_clamped"
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "lhs_ref": "pauc.DS7.IQ_OOD_ONLY",
                      "op": ">=",
                      "rhs_ref": "pauc.DS7.NC_TOPI_clamped"
                    },
                    {
                      "lhs_ref": "pauc.DS8.IQ_OOD_ONLY",
                      "op": ">=",
                      "rhs_ref": "pauc.DS8.NC_TOPI_clamped"
                    }
                  ]
                },
                {
                  "lhs_ref": "paired_ci.DS7.NC_TOPI_clamped_minus_IQ_LOW_ONLY.upper",
                  "op": "<=",
                  "rhs_value": 0.0
                },
                {
                  "lhs_ref": "paired_ci.DS8.NC_TOPI_clamped_minus_IQ_LOW_ONLY.upper",
                  "op": "<=",
                  "rhs_value": 0.0
                },
                {
                  "lhs_ref": "paired_ci.DS7.NC_TOPI_clamped_minus_IQ_OOD_ONLY.upper",
