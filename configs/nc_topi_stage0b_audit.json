        "eligibility": "pAUC(NC_TOPI_original)-pAUC(B0) > 0",
        "gain_fraction": "(pAUC(IQ_LOW_ONLY)-pAUC(B0))/(pAUC(NC_TOPI_original)-pAUC(B0))",
        "gain_fraction_predicate": ">= 0.5",
        "alarm_overlap": "count(NC_TOPI_original_q99_alarm AND IQ_LOW_ONLY_q99_alarm)/count(NC_TOPI_original_q99_alarm)",
        "alarm_overlap_predicate": ">= 0.5",
        "zero_original_alarm_denominator": "trigger false with explicit not_evaluable reason",
