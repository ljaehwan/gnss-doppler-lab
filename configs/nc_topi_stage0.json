  "decision": {
    "go_primary": "q99 NC-TOPI median only",
    "attack_scenario_pass": "standardized pAUC point delta >0 OR both sustained delays finite and NC at least 0.5s earlier",
    "ci_criterion": "paired pAUC delta percentile95 CI lower >0",
    "shuffle_criterion": "actual NC mean pAUC gain over TOPI > shuffled gain AND actual gain >0",
    "GO": "all frozen criteria pass",
    "NO-GO": "c6 false OR c7 false OR clean NC FPR >0.05 OR stable-pre failures >=3 OR known improvement count <=1 OR known positive CI count ==0",
    "INCONCLUSIVE": "all outcomes not classified GO or NO-GO by the frozen grammar",
    "criteria": {
      "c1": "clean_holdout_nc_fpr <= 0.02",
      "c2": "clean_holdout_nc_fpr - clean_holdout_b0_fpr <= 0.01",
      "c3": "all five scenario stable_pre_fpr < 0.05",
      "c4": "count(pauc_delta > 0 OR (finite delays AND b0_delay-nc_delay >= 0.5)) >= 3",
      "c5": "count(paired_pauc_ci_lower > 0) >= 2",
      "c6": "equal_rmse_pass == true",
      "c7": "second_peak_pass == true",
      "c8": "actual_mean_pauc_gain > shuffled_gain AND actual_mean_pauc_gain > 0"
    },
    "boolean_grammar": {
      "GO": "c1 && c2 && c3 && c4 && c5 && c6 && c7 && c8",
      "NO_GO": "(!c6) || (!c7) || (clean_nc_fpr > 0.05) || (stable_pre_failures >= 3) || (improvement_count <= 1) || (positive_ci_count == 0)",
      "precedence": "NO-GO triggers first; then GO; otherwise INCONCLUSIVE",
      "missing": "missing mandatory evidence prevents GO and is not itself a NO-GO trigger"
    },
    "machine_grammar": {
      "criteria": {
        "c1": {
          "lhs": "clean_nc_fpr",
          "op": "<=",
          "rhs": 0.02
        },
        "c2": {
          "lhs": "clean_nc_fpr-clean_b0_fpr",
          "op": "<=",
          "rhs": 0.01
        },
        "c3": {
          "quantifier": "all_5",
          "lhs": "stable_pre_fpr",
          "op": "<",
          "rhs": 0.05
        },
        "c4": {
          "lhs": "scenario_improvement_pass_count",
          "op": ">=",
          "rhs": 3
        },
        "c5": {
          "lhs": "positive_paired_ci_count",
          "op": ">=",
          "rhs": 2
        },
        "c6": {
          "lhs": "equal_rmse_pass",
          "op": "is",
          "rhs": true
        },
        "c7": {
          "lhs": "second_peak_pass",
          "op": "is",
          "rhs": true
        },
        "c8": {
          "all": [
            "actual_gain > shuffled_gain",
            "actual_gain > 0"
          ]
        }
      },
      "go": {
        "all": [
          "c1",
          "c2",
          "c3",
          "c4",
          "c5",
          "c6",
          "c7",
          "c8"
        ]
      },
      "no_go": {
        "any": [
          "c6 is false",
          "c7 is false",
          "clean_nc_fpr > 0.05",
          "stable_pre_failures >= 3",
          "known_improvement_count <= 1",
          "known_positive_ci_count == 0"
        ]
      },
      "missing_mandatory": "blocks GO; does not itself trigger NO-GO"
    }
  }
