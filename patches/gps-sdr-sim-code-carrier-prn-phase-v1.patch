+int carrierPhaseSeedEnabled = FALSE;
+uint64_t carrierPhaseSeed = 0;
+
+double deterministicCarrierPhase(uint64_t seed, int prn)
+{
+	uint64_t x = seed + 0x9E3779B97F4A7C15ULL * (uint64_t)prn;
+	x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+	x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+	x = x ^ (x >> 31);
+	return((double)(x >> 11) * (1.0 / 9007199254740992.0));
+}
 
