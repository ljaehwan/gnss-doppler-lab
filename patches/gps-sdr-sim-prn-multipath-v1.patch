 #include "gpssim.h"
+#define MULTIPATH_LINE_SIZE 512
+
+typedef struct
+{
+	int enabled;
+	int whole_delay_samples;
+	double fractional_delay_samples;
+	double amplitude_ratio;
+	double phase_cos;
+	double phase_sin;
+} multipath_spec_t;
+
+static int readMultipathSpecs(const char *filename,
+	multipath_spec_t specs[MAX_SAT], double sample_rate_hz, int *history_length)
+{
+	FILE *fp;
+	char line[MULTIPATH_LINE_SIZE];
+	int line_number = 0;
+	int spec_count = 0;
+	double maximum_delay = 0.0;
+
+	fp = fopen(filename, "r");
+	if (fp == NULL)
+	{
+		fprintf(stderr, "ERROR: Failed to open multipath specification file: %s\n", filename);
+		return(-1);
+	}
+
+	while (fgets(line, sizeof(line), fp) != NULL)
+	{
+		char *cursor = line;
+		char extra;
+		int prn;
+		double delay_samples;
+		double amplitude_ratio;
+		double phase_degrees;
+		double phase_radians;
+
+		line_number++;
+		while (*cursor == ' ' || *cursor == '\t')
+			cursor++;
+		if (*cursor == '\0' || *cursor == '\n' || *cursor == '\r' || *cursor == '#')
+			continue;
+
+		if (sscanf(cursor, " %d , %lf , %lf , %lf %c",
+			&prn, &delay_samples, &amplitude_ratio, &phase_degrees, &extra) != 4)
+		{
+			fprintf(stderr, "ERROR: Invalid multipath specification at line %d.\n", line_number);
+			fclose(fp);
+			return(-1);
+		}
+		if (prn < 1 || prn > MAX_SAT || specs[prn-1].enabled)
+		{
+			fprintf(stderr, "ERROR: Invalid or duplicate multipath PRN at line %d.\n", line_number);
+			fclose(fp);
+			return(-1);
+		}
+		if (!isfinite(delay_samples) || delay_samples < 1.0 ||
+			delay_samples > sample_rate_hz * 0.001)
+		{
+			fprintf(stderr, "ERROR: Multipath delay at line %d must be within [1 sample, 1 ms].\n", line_number);
+			fclose(fp);
+			return(-1);
+		}
+		if (!isfinite(amplitude_ratio) || amplitude_ratio <= 0.0 || amplitude_ratio > 1.0 ||
+			!isfinite(phase_degrees))
+		{
+			fprintf(stderr, "ERROR: Invalid multipath amplitude or phase at line %d.\n", line_number);
+			fclose(fp);
+			return(-1);
+		}
+
+		phase_radians = phase_degrees * (4.0 * atan(1.0)) / 180.0;
+		specs[prn-1].enabled = TRUE;
+		specs[prn-1].whole_delay_samples = (int)floor(delay_samples);
+		specs[prn-1].fractional_delay_samples =
+			delay_samples - floor(delay_samples);
+		specs[prn-1].amplitude_ratio = amplitude_ratio;
+		specs[prn-1].phase_cos = cos(phase_radians);
+		specs[prn-1].phase_sin = sin(phase_radians);
+		if (delay_samples > maximum_delay)
+			maximum_delay = delay_samples;
+		spec_count++;
+	}
+
+	fclose(fp);
+	if (spec_count == 0)
+	{
+		fprintf(stderr, "ERROR: Multipath specification file contains no active PRNs.\n");
+		return(-1);
+	}
+	*history_length = (int)ceil(maximum_delay) + 2;
+	fprintf(stderr, "Loaded %d PRN-specific multipath specifications from %s\n",
+		spec_count, filename);
+	return(0);
+}
 
